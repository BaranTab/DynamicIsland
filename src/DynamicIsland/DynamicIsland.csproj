<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target: required for the Windows.Media.Control (GSMTC) API -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DynamicIsland</RootNamespace>
    <AssemblyName>DynamicIsland</AssemblyName>
    <Product>Dynamic Island for Windows</Product>
    <Authors>Baran Tabak</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mail: reads the inbox over IMAP -->
    <PackageReference Include="MailKit" Version="4.*" />
    <!-- VS Code: its recently opened list lives in a SQLite database -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Translations, loaded at runtime as "Languages.<code>.json" -->
    <EmbeddedResource Include="Localization\Languages\*.json" LogicalName="Languages.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
