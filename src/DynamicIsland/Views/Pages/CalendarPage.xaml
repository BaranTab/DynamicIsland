<UserControl x:Class="DynamicIsland.Views.Pages.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="636" Height="190" Foreground="White">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CalendarGreen" Color="#3FB68B" />
        <Style x:Key="WeekDay" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: ay görünümü -->
        <Border Style="{StaticResource Panel}" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding CalendarMonthTitle}" Style="{StaticResource Label}" Margin="2,0,0,0" />

                <UniformGrid Grid.Row="1" Columns="7" Margin="0,6,0,2">
                    <TextBlock Text="Pt" Style="{StaticResource WeekDay}" />
                    <TextBlock Text="Sa" Style="{StaticResource WeekDay}" />
                    <TextBlock Text="Ça" Style="{StaticResource WeekDay}" />
                    <TextBlock Text="Pe" Style="{StaticResource WeekDay}" />
                    <TextBlock Text="Cu" Style="{StaticResource WeekDay}" />
                    <TextBlock Text="Ct" Style="{StaticResource WeekDay}" />
                    <TextBlock Text="Pz" Style="{StaticResource WeekDay}" />
                </UniformGrid>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Opacity="{Binding Opacity}">
                                <Ellipse Width="19" Height="19" Fill="White" Visibility="{Binding TodayVisibility}" />
                                <TextBlock Text="{Binding Day}" FontSize="10.5" Foreground="{Binding Foreground}"
                                           FontWeight="{Binding Weight}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CalendarGreen}"
                                         VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-1"
                                         Visibility="{Binding EventDotVisibility}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Sağ: bugün ve yaklaşan etkinlikler -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE8A7;"
                        ToolTip="Takvimi aç" Click="OpenCalendar_Click" Margin="0,-6,0,0" />
                <TextBlock Text="YAKLAŞAN" Style="{StaticResource Label}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding CalendarTodayTitle}" FontSize="18" FontWeight="SemiBold"
                       Margin="0,2,0,0" />

            <ItemsControl Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding UpcomingEvents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" CornerRadius="1.5" Background="{StaticResource CalendarGreen}"
                                    Margin="0,1,10,1" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding When}" FontFamily="{StaticResource Mono}" FontSize="10"
                                           Opacity="0.55" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="2" Text="Önümüzdeki günlerde etkinlik yok 🎉" FontSize="13" Opacity="0.55"
                       VerticalAlignment="Center" Visibility="{Binding NoEventsVisibility}" />

            <StackPanel Grid.Row="2" VerticalAlignment="Center" Visibility="{Binding CalendarSetupVisibility}">
                <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,10"
                           Text="Etkinliklerin için Google Takvim → Ayarlar → takvimin → 'iCal biçimindeki gizli adres'i kopyala ve ayarlar dosyasında Calendar → IcsUrl alanına yapıştır." />
                <Button Style="{StaticResource SmallPillButton}" HorizontalAlignment="Left"
                        Content="Ayarları aç" Click="OpenSettings_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
