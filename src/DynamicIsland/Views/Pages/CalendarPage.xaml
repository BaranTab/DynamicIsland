<UserControl x:Class="DynamicIsland.Views.Pages.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DynamicIsland.Localization"
             Width="636" Height="190" Foreground="White">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CalendarGreen" Color="#3FB68B" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: month view -->
        <Border Style="{StaticResource Panel}" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding CalendarMonthTitle}" Style="{StaticResource Label}" Margin="2,0,0,0" />

                <!-- Weekday names (Monday first, in the current language) -->
                <ItemsControl Grid.Row="1" Margin="0,6,0,2" ItemsSource="{Binding WeekDayNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="9"
                                       Opacity="0.5" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Opacity="{Binding Opacity}">
                                <Ellipse Width="19" Height="19" Fill="White" Visibility="{Binding TodayVisibility}" />
                                <TextBlock Text="{Binding Day}" FontSize="10.5" Foreground="{Binding Foreground}"
                                           FontWeight="{Binding Weight}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource CalendarGreen}"
                                         VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-1"
                                         Visibility="{Binding EventDotVisibility}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Right: today and upcoming events -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE8A7;"
                        ToolTip="{loc:T CalendarOpen}" Click="OpenCalendar_Click" Margin="0,-6,0,0" />
                <TextBlock Text="{loc:T CalendarUpcoming}" Style="{StaticResource Label}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding CalendarTodayTitle}" FontSize="18" FontWeight="SemiBold"
                       Margin="0,2,0,0" />

            <ItemsControl Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding UpcomingEvents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" CornerRadius="1.5" Background="{StaticResource CalendarGreen}"
                                    Margin="0,1,10,1" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding When}" FontFamily="{StaticResource Mono}" FontSize="10"
                                           Opacity="0.55" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="2" Text="{loc:T CalendarNoEvents}" FontSize="13" Opacity="0.55"
                       VerticalAlignment="Center" Visibility="{Binding NoEventsVisibility}" />

            <!-- Setup instructions (when no iCal address is configured) -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" Visibility="{Binding CalendarSetupVisibility}">
                <TextBlock Text="{loc:T CalendarSetupText}" FontSize="11.5" Opacity="0.65" TextWrapping="Wrap"
                           LineHeight="16" Margin="0,0,0,10" />
                <Button Style="{StaticResource SmallPillButton}" HorizontalAlignment="Left"
                        Content="{loc:T OpenSettings}" Click="OpenSettings_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
