<UserControl x:Class="DynamicIsland.Views.Pages.TodoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DynamicIsland.Localization"
             Width="636" Height="190" Foreground="White">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TodoCyan" Color="#36B3D9" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="170" />
        </Grid.ColumnDefinitions>

        <!-- Left: new task input + task list -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border CornerRadius="12" Background="#16FFFFFF" BorderBrush="#2636B3D9" BorderThickness="1"
                    Padding="12,0,4,0" Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewTask" Background="Transparent" BorderThickness="0" Foreground="White"
                             CaretBrush="#36B3D9" SelectionBrush="#36B3D9" FontSize="13" VerticalAlignment="Center"
                             FocusVisualStyle="{x:Null}"
                             PreviewMouseLeftButtonDown="NewTask_PreviewMouseLeftButtonDown"
                             TextChanged="NewTask_TextChanged" KeyDown="NewTask_KeyDown" />
                    <TextBlock x:Name="Placeholder" Text="{loc:T TodoAddPlaceholder}" FontSize="13" Opacity="0.4"
                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" />

                    <Button Grid.Column="1" Style="{StaticResource SmallIconButton}" Content="&#xE710;"
                            ToolTip="{loc:T TodoAdd}" Click="Add_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="TaskList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowItem}" Padding="10,7" Cursor="Arrow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Round checkbox -->
                                    <Border Width="18" Height="18" CornerRadius="9" Cursor="Hand"
                                            BorderThickness="1.5" BorderBrush="{Binding CheckBorder}"
                                            Background="{Binding CheckFill}" Tag="{Binding Id}"
                                            MouseLeftButtonUp="Toggle_Click">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" FontSize="9"
                                                   Foreground="Black" HorizontalAlignment="Center"
                                                   Visibility="{Binding CheckVisibility}" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" Margin="10,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Opacity="{Binding TextOpacity}"
                                               TextDecorations="{Binding Decorations}" />

                                    <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Width="22" Height="22"
                                            FontSize="9" Content="&#xE711;" Opacity="0.5" Tag="{Binding Id}"
                                            Click="Delete_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="{loc:T TodoEmpty}" FontSize="13" Opacity="0.5"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>

        <!-- Right: progress card -->
        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE9D5;" Style="{StaticResource IconGlyph}"
                               Foreground="{StaticResource TodoCyan}" />
                    <TextBlock Text="{loc:T TodoProgress}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Mono}">
                        <Run x:Name="DoneCount" Text="0" FontSize="38" FontWeight="SemiBold" /><Run x:Name="TotalCount" Text="/0" FontSize="18" Foreground="#80FFFFFF" />
                    </TextBlock>
                    <TextBlock x:Name="ProgressCaption" Text="{loc:T TodoCompleted}" FontSize="12" Opacity="0.7" />

                    <Grid Height="5" Margin="0,10,0,0">
                        <Border CornerRadius="2.5" Background="#22FFFFFF" />
                        <Border x:Name="ProgressFill" CornerRadius="2.5" Background="{StaticResource TodoCyan}"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>

                <Button Grid.Row="2" Style="{StaticResource SmallGhostButton}" HorizontalAlignment="Stretch"
                        Content="{loc:T TodoClearDone}" Click="ClearDone_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
