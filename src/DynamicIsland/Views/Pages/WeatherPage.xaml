<UserControl x:Class="DynamicIsland.Views.Pages.WeatherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="636" Height="190" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding WeatherLocationLabel}" Style="{StaticResource Label}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding WeatherIcon}" FontSize="40" VerticalAlignment="Center" />
                <TextBlock Text="{Binding WeatherTemp}" FontSize="64" FontWeight="Light"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding WeatherDescription}" FontSize="15" />
            <TextBlock Text="{Binding WeatherMinMax}" FontSize="12" Opacity="0.55" Margin="0,2,0,0" />
        </StackPanel>

        <ItemsControl Grid.Column="1" ItemsSource="{Binding HourlyForecasts}"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="62" Margin="4,0" CornerRadius="18" Background="#14FFFFFF" Padding="0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Hour}" FontFamily="{StaticResource Mono}"
                                       FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Icon}" FontSize="20" Margin="0,8" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Temperature, StringFormat={}{0:0}°}"
                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
