<UserControl x:Class="DynamicIsland.Views.Pages.VsCodePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DynamicIsland.Localization"
             Width="636" Height="190" Foreground="White">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CodeBlue" Color="#3B9BFF" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <!-- Left: recent workspaces, styled like the Explorer sidebar -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE76C;" Style="{StaticResource IconGlyph}" FontSize="9" Opacity="0.6" Margin="0,0,6,0" />
                <TextBlock Text="{loc:T VsCodeRecent}" Style="{StaticResource Label}" />
            </StackPanel>

            <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding VsCodeRecents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowItem}" Padding="12,8" Tag="{Binding Path}"
                                MouseLeftButtonUp="Recent_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thin blue line on the left edge -->
                                <Border Width="3" CornerRadius="1.5" Background="{StaticResource CodeBlue}"
                                        Margin="-6,2,8,2" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyph}"
                                               Foreground="{StaticResource CodeBlue}" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource Mono}" FontSize="10"
                                                   Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE8A7;" Style="{StaticResource IconGlyph}"
                                           FontSize="11" Opacity="0.6" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="1" Visibility="{Binding VsCodeEmptyVisibility}" FontSize="13" Opacity="0.55"
                       TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T VsCodeEmpty}" />
        </Grid>

        <!-- Right: VS Code card -->
        <Border Grid.Column="2" CornerRadius="20" Padding="16,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2F80ED" Offset="0" />
                    <GradientStop Color="#123A78" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="VS CODE" Style="{StaticResource Label}" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE943;" Style="{StaticResource IconGlyph}" FontSize="34" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T VsCodeTagline1}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:T VsCodeTagline2}" FontSize="14" Opacity="0.75" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource SmallPillButton}" HorizontalAlignment="Stretch"
                            Content="{loc:T VsCodeNewWindow}" Click="NewWindow_Click" />
                    <Button Style="{StaticResource SmallGhostButton}" HorizontalAlignment="Stretch"
                            Content="{loc:T VsCodeOpenFolder}" Margin="0,6,0,0" Click="OpenFolder_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
