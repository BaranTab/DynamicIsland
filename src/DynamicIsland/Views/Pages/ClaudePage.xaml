<UserControl x:Class="DynamicIsland.Views.Pages.ClaudePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DynamicIsland.Localization"
             Width="636" Height="190" Foreground="White">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ClaudeOrange" Color="#D97757" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: a terminal window -->
        <Border CornerRadius="18" Background="#E60C0C0E" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="#FF5F57" Margin="0,0,5,0" />
                    <Ellipse Width="9" Height="9" Fill="#FEBC2E" Margin="0,0,5,0" />
                    <Ellipse Width="9" Height="9" Fill="#28C840" Margin="0,0,10,0" />
                    <TextBlock Text="CLAUDE CODE" Style="{StaticResource Label}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Prompt with a blinking cursor -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Mono}" FontSize="12" Opacity="0.6">
                        <Run Text="~/" /><Run Text="{Binding ClaudePromptFolder, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="&gt; " FontFamily="{StaticResource Mono}" FontSize="16"
                                   Foreground="{StaticResource ClaudeOrange}" />
                        <TextBlock Text="claude" FontFamily="{StaticResource Mono}" FontSize="16" />
                        <Rectangle Width="9" Height="18" Fill="{StaticResource ClaudeOrange}" Margin="4,0,0,0">
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0"
                                                             Duration="0:0:0.55" AutoReverse="True"
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource SmallPillButton}" HorizontalAlignment="Stretch"
                            Background="{StaticResource ClaudeOrange}" Foreground="White"
                            Content="{loc:T ClaudeStartLast}" Click="StartLast_Click" />
                    <Button Style="{StaticResource SmallGhostButton}" HorizontalAlignment="Stretch"
                            Content="{loc:T ClaudePickFolder}" Margin="0,6,0,0" Click="PickFolder_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: recent projects -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{loc:T ClaudeRecent}" Style="{StaticResource Label}" />

            <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding ClaudeProjects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowItem}" Padding="12,8" Tag="{Binding Path}"
                                MouseLeftButtonUp="Project_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}"
                                           Foreground="{StaticResource ClaudeOrange}" />
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource Mono}" FontSize="10"
                                               Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE768;" Style="{StaticResource IconGlyph}"
                                           FontSize="11" Opacity="0.6" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="1" Visibility="{Binding ClaudeEmptyVisibility}" FontSize="13" Opacity="0.55"
                       TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T ClaudeEmpty}" />
        </Grid>
    </Grid>
</UserControl>
