<UserControl x:Class="DynamicIsland.Views.Pages.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DynamicIsland.Localization"
             xmlns:controls="clr-namespace:DynamicIsland.Controls"
             Width="636" Height="190" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Album art -->
        <Grid Width="170" Height="170" VerticalAlignment="Center">
            <Border CornerRadius="24" Background="#26262C" />
            <Border CornerRadius="24">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyph}" FontSize="40" Opacity="0.3"
                       HorizontalAlignment="Center" Visibility="{Binding NoMediaVisibility}" />
        </Grid>

        <Grid Grid.Column="1" Margin="24,2,0,0" Visibility="{Binding MediaVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- "NOW PLAYING · SPOTIFY" + lyrics status ("Searching for lyrics…") -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LyricsStatus}" FontSize="10" Opacity="0.45"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding MediaSourceLabel}" Style="{StaticResource Label}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- WITH LYRICS: small title line + three lyric lines (previous / current / next) -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding LyricsVisibility}">
                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,6">
                    <Run Text="{Binding MediaTitle, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="·" Foreground="#80FFFFFF" />
                    <Run Text="{Binding MediaArtist, Mode=OneWay}" Foreground="#B3FFFFFF" />
                </TextBlock>

                <StackPanel x:Name="LyricsBlock">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="LyricsShift" />
                    </StackPanel.RenderTransform>

                    <TextBlock x:Name="PreviousLine" Text="{Binding LyricPrevious}" FontSize="13"
                               Opacity="0.35" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CurrentLine" Text="{Binding LyricCurrent}" FontSize="19" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" Margin="0,3" />
                    <TextBlock x:Name="NextLine" Text="{Binding LyricNext}" FontSize="13"
                               Opacity="0.35" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!-- WITHOUT LYRICS: large title and artist -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding NoLyricsVisibility}">
                <TextBlock Text="{Binding MediaTitle}" FontSize="28" FontWeight="Bold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="72" LineHeight="34" />
                <TextBlock Text="{Binding MediaArtist}" FontSize="14" Opacity="0.7" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Progress bar -->
            <Grid Grid.Row="2" Visibility="{Binding ProgressVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource Mono}" FontSize="10"
                           Opacity="0.6" VerticalAlignment="Center" />
                <!-- Click or drag to jump to a position -->
                <controls:SeekBar x:Name="Seek" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                  Value="{Binding ProgressValue, Mode=OneWay}"
                                  IsInteractive="{Binding CanSeek, Mode=OneWay}" />
                <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontFamily="{StaticResource Mono}"
                           FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
            </Grid>

            <!-- Controls -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Previous_Click" />
                <Button Style="{StaticResource PlayButton}" Width="42" Height="42" FontSize="16"
                        Content="{Binding PlayPauseGlyph}" Margin="14,0" Click="PlayPause_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding NoMediaVisibility}">
            <TextBlock Text="{loc:T NothingPlaying}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{loc:T NothingPlayingHint}" FontSize="13" Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
