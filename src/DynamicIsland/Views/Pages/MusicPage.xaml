<UserControl x:Class="DynamicIsland.Views.Pages.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="636" Height="190" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Width="170" Height="170" VerticalAlignment="Center">
            <Border CornerRadius="24" Background="#26262C" />
            <Border CornerRadius="24">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyph}" FontSize="40" Opacity="0.3"
                       HorizontalAlignment="Center" Visibility="{Binding NoMediaVisibility}" />
        </Grid>

        <Grid Grid.Column="1" Margin="24,6,0,4" Visibility="{Binding MediaVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding MediaSourceLabel}" Style="{StaticResource Label}" />

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding MediaTitle}" FontSize="28" FontWeight="Bold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="72" LineHeight="34" />
                <TextBlock Text="{Binding MediaArtist}" FontSize="14" Opacity="0.7" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- İlerleme çubuğu -->
            <Grid Grid.Row="2" Visibility="{Binding ProgressVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource Mono}" FontSize="10"
                           Opacity="0.6" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="4" Margin="10,0" VerticalAlignment="Center">
                    <Border CornerRadius="2" Background="#33FFFFFF" />
                    <Border CornerRadius="2" Background="White" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding ProgressValue}" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontFamily="{StaticResource Mono}"
                           FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
            </Grid>

            <!-- Kontroller -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Previous_Click" />
                <Button Style="{StaticResource PlayButton}" Content="{Binding PlayPauseGlyph}"
                        Margin="14,0" Click="PlayPause_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding NoMediaVisibility}">
            <TextBlock Text="Şu an bir şey çalmıyor" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Spotify, YouTube ya da başka bir uygulamada müzik açınca burada görünecek."
                       FontSize="13" Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
