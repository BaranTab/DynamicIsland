<UserControl x:Class="DynamicIsland.Views.Pages.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DynamicIsland.Localization"
             Width="636" Height="190" Foreground="White">
    <UserControl.Resources>
        <SolidColorBrush x:Key="NoteYellow" Color="#F2C14E" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="190" />
        </Grid.ColumnDefinitions>

        <!-- Left: paper-like editor -->
        <Border CornerRadius="18" Padding="16,12" BorderThickness="1" BorderBrush="#26F2C14E">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#26F2C14E" Offset="0" />
                    <GradientStop Color="#0DF2C14E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock x:Name="SavedText" DockPanel.Dock="Right" FontSize="10" Opacity="0.5"
                               FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70B;" Style="{StaticResource IconGlyph}" FontSize="12"
                                   Foreground="{StaticResource NoteYellow}" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T NotesNote}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <TextBox x:Name="Editor" Grid.Row="1" Margin="-2,8,0,0"
                         Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#F2C14E"
                         SelectionBrush="#F2C14E" FontSize="14" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" FocusVisualStyle="{x:Null}"
                         PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown"
                         TextChanged="Editor_TextChanged" />

                <TextBlock x:Name="Placeholder" Grid.Row="1" Margin="0,9,0,0" FontSize="14" Opacity="0.35"
                           IsHitTestVisible="False" Text="{loc:T NotesPlaceholder}" />
            </Grid>
        </Border>

        <!-- Right: list of notes -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                        ToolTip="{loc:T NotesDelete}" Click="Delete_Click" Margin="0,-6,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE710;"
                        ToolTip="{loc:T NotesNew}" Click="New_Click" Margin="0,-6,0,0" />
                <TextBlock Text="{loc:T TabNotes}" Style="{StaticResource Label}" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl x:Name="NotesList" Grid.Row="1" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Padding="10,6" Margin="0,0,0,5" Cursor="Hand"
                                Background="{Binding Background}" Tag="{Binding Id}"
                                MouseLeftButtonUp="Note_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.55" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
