<UserControl x:Class="DynamicIsland.Views.Pages.FocusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DynamicIsland.Controls"
             xmlns:loc="clr-namespace:DynamicIsland.Localization"
             Width="636" Height="190" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding FocusRemainingText}" FontFamily="{StaticResource Mono}"
                           FontSize="72" FontWeight="SemiBold" Margin="-4,-6,0,0" />
                <TextBlock Text="{Binding FocusEndText}" FontSize="13" Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Style="{StaticResource PillButton}" Content="{Binding FocusButtonText}"
                        Click="StartPause_Click" />
                <Button Style="{StaticResource GhostPillButton}" Content="{loc:T FocusReset}"
                        Margin="0,8,0,0" Click="Reset_Click" />
            </StackPanel>
        </Grid>

        <!-- Duration picker (minutes) -->
        <controls:TickRuler x:Name="Ruler" Grid.Row="1" Height="44" Maximum="60" Value="25"
                            Margin="0,4,0,0" Cursor="SizeWE" />
    </Grid>
</UserControl>
