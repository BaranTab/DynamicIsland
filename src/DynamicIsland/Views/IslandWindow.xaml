<Window x:Class="DynamicIsland.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DynamicIsland.Controls"
        xmlns:pages="clr-namespace:DynamicIsland.Views.Pages"
        Title="Dynamic Island"
        Width="820" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="White"
        TextOptions.TextFormattingMode="Ideal">

    <!-- Pencerenin şeffaf kısımları tıklamayı alttaki uygulamalara geçirir;
         sadece cam ada şekli fareyi yakalar. Stiller: Themes/Styles.xaml -->

    <Grid x:Name="IslandRoot" MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">

        <!-- CAM ŞEKİL -->
        <controls:IslandShape x:Name="Glass"
                              BodyWidth="150" BodyHeight="32" BottomRadius="14" FilletRadius="10"
                              GlowStrength="0" />

        <!-- İçerik, camın gövdesiyle birlikte büyür -->
        <Grid x:Name="Body" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True"
              Width="{Binding BodyWidth, ElementName=Glass}"
              Height="{Binding BodyHeight, ElementName=Glass}">

            <!-- ======================= KAPALI ADA ======================= -->
            <Grid x:Name="CompactView" Height="32" Margin="14,0" VerticalAlignment="Top">

                <!-- Boşta: iki küçük nokta -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IdleVisibility}">
                    <Ellipse Width="6" Height="6" Fill="White" Opacity="0.85" Margin="3,0" />
                    <Ellipse Width="6" Height="6" Fill="White" Opacity="0.85" Margin="3,0" />
                </StackPanel>

                <!-- Müzik: küçük kapak + ekolayzer -->
                <Grid Visibility="{Binding MusicCompactVisibility}">
                    <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border CornerRadius="6" Background="#333" />
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="Equalizer" Orientation="Horizontal" Height="14"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0"
                                   Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0"
                                   Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0"
                                   Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0"
                                   Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <!-- Odak çalışıyor: kalan süre -->
                <Grid Visibility="{Binding TimerCompactVisibility}">
                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FocusRemainingText}" FontFamily="{StaticResource Mono}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- ======================= AÇIK PANEL ======================= -->
            <Grid x:Name="ExpandedView" Width="636" Margin="0,14,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Üst bilgi satırı -->
                <Grid>
                    <TextBlock Text="{Binding HeaderLeft}" FontFamily="{StaticResource Mono}" FontSize="11"
                               Opacity="0.75" VerticalAlignment="Center" />

                    <StackPanel x:Name="Dots" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource PageDot}" Tag="0" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="1" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="2" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="3" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="4" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="5" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="6" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="7" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="8" MouseLeftButtonUp="Navigate_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource Mono}" FontSize="11"
                                   Opacity="0.85" VerticalAlignment="Center" />
                        <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;"
                                Width="26" Height="22" FontSize="12" Margin="8,0,0,0" Click="More_Click">
                            <Button.ContextMenu>
                                <ContextMenu Closed="Menu_Closed">
                                    <MenuItem Header="Ayarlar dosyasını aç" Click="Settings_Click" />
                                    <Separator />
                                    <MenuItem Header="Çıkış" Click="Exit_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Sayfalar.
                     Not: Sayfa şeridi bir Canvas içinde, çünkü Canvas çocuklarını kırpmaz.
                     (Doğrudan Border içine konunca şerit 636 px'te kırpılıyor ve diğer sayfalar boş görünüyordu.) -->
                <Border x:Name="PagesViewport" Grid.Row="1" Width="636" Height="190" Margin="0,10,0,0"
                        ClipToBounds="True" Background="Transparent"
                        PreviewMouseLeftButtonDown="Viewport_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Viewport_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Viewport_PreviewMouseLeftButtonUp"
                        MouseWheel="Viewport_MouseWheel">
                    <Canvas>
                        <StackPanel x:Name="PagesStrip" Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PagesTransform" />
                            </StackPanel.RenderTransform>

                            <pages:HomePage />      <!-- 0 -->
                            <pages:MusicPage />     <!-- 1 -->
                            <pages:FocusPage />     <!-- 2 -->
                            <pages:WeatherPage />   <!-- 3 -->
                            <pages:MailPage />      <!-- 4 -->
                            <pages:ClaudePage />    <!-- 5 -->
                            <pages:VsCodePage />    <!-- 6 -->
                            <pages:NotesPage />     <!-- 7 -->
                            <pages:CalendarPage />  <!-- 8 -->
                        </StackPanel>
                    </Canvas>
                </Border>

                <!-- Alt sekme çubuğu -->
                <StackPanel x:Name="Tabs" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,12">
                    <Border Style="{StaticResource TabItem}" Tag="0" MouseLeftButtonUp="Navigate_Click" ToolTip="Ana Sayfa">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="ANA SAYFA" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="1" MouseLeftButtonUp="Navigate_Click" ToolTip="Müzik">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="MÜZİK" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="2" MouseLeftButtonUp="Navigate_Click" ToolTip="Odak">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE916;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="ODAK" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="3" MouseLeftButtonUp="Navigate_Click" ToolTip="Hava Durumu">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE706;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="HAVA" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="4" MouseLeftButtonUp="Navigate_Click" ToolTip="Posta">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE715;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="POSTA" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="5" MouseLeftButtonUp="Navigate_Click" ToolTip="Claude Code">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE756;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="CLAUDE" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="6" MouseLeftButtonUp="Navigate_Click" ToolTip="VS Code">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE943;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="VS CODE" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="7" MouseLeftButtonUp="Navigate_Click" ToolTip="Notlar">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE70B;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="NOTLAR" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="8" MouseLeftButtonUp="Navigate_Click" ToolTip="Takvim">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="TAKVİM" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
