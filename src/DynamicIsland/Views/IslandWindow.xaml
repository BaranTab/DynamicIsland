<Window x:Class="DynamicIsland.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DynamicIsland.Controls"
        xmlns:pages="clr-namespace:DynamicIsland.Views.Pages"
        xmlns:loc="clr-namespace:DynamicIsland.Localization"
        Title="Dynamic Island"
        Width="820" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="White"
        TextOptions.TextFormattingMode="Ideal">

    <!-- Transparent parts of the window pass clicks through to the apps below;
         only the glass island shape captures the mouse. Styles: Themes/Styles.xaml -->

    <Grid x:Name="IslandRoot" MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">

        <!-- GLASS SHAPE -->
        <controls:IslandShape x:Name="Glass"
                              BodyWidth="150" BodyHeight="32" BottomRadius="14" FilletRadius="10"
                              GlowStrength="0" />

        <!-- Content grows together with the glass body -->
        <Grid x:Name="Body" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True"
              Width="{Binding BodyWidth, ElementName=Glass}"
              Height="{Binding BodyHeight, ElementName=Glass}">

            <!-- ===================== COMPACT ISLAND ===================== -->
            <Grid x:Name="CompactView" Height="32" Margin="14,0" VerticalAlignment="Top">

                <!-- Idle: two small dots -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IdleVisibility}">
                    <Ellipse Width="6" Height="6" Fill="White" Opacity="0.85" Margin="3,0" />
                    <Ellipse Width="6" Height="6" Fill="White" Opacity="0.85" Margin="3,0" />
                </StackPanel>

                <!-- Music: tiny album art + (current lyric line) + equalizer -->
                <Grid Visibility="{Binding MusicCompactVisibility}">
                    <TextBlock x:Name="CompactLyric" Text="{Binding CompactLyricText}"
                               Visibility="{Binding CompactLyricVisibility}"
                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,34,0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="CompactLyricShift" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border CornerRadius="6" Background="#333" />
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="Equalizer" Orientation="Horizontal" Height="14"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0"
                                   Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0"
                                   Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0"
                                   Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0"
                                   Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <!-- Focus timer running: remaining time -->
                <Grid Visibility="{Binding TimerCompactVisibility}">
                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FocusRemainingText}" FontFamily="{StaticResource Mono}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- ===================== EXPANDED PANEL ===================== -->
            <Grid x:Name="ExpandedView" Width="636" Margin="0,14,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid>
                    <TextBlock Text="{Binding HeaderLeft}" FontFamily="{StaticResource Mono}" FontSize="11"
                               Opacity="0.75" VerticalAlignment="Center" />

                    <StackPanel x:Name="Dots" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource PageDot}" Tag="0" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="1" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="2" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="3" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="4" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="5" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="6" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="7" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="8" MouseLeftButtonUp="Navigate_Click" />
                        <Border Style="{StaticResource PageDot}" Tag="9" MouseLeftButtonUp="Navigate_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource Mono}" FontSize="11"
                                   Opacity="0.85" VerticalAlignment="Center" />
                        <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;"
                                Width="26" Height="22" FontSize="12" Margin="8,0,0,0" Click="More_Click">
                            <Button.ContextMenu>
                                <ContextMenu Closed="Menu_Closed">
                                    <MenuItem x:Name="LanguageMenu" Header="{loc:T MenuLanguage}" />
                                    <MenuItem Header="{loc:T MenuSettings}" Click="Settings_Click" />
                                    <Separator />
                                    <MenuItem Header="{loc:T MenuExit}" Click="Exit_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Pages.
                     The page strip lives inside a Canvas because a Canvas never clips its children.
                     (Placed directly in the Border, the strip was clipped at 636 px and the other pages looked empty.) -->
                <Border x:Name="PagesViewport" Grid.Row="1" Width="636" Height="190" Margin="0,10,0,0"
                        ClipToBounds="True" Background="Transparent"
                        PreviewMouseLeftButtonDown="Viewport_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Viewport_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Viewport_PreviewMouseLeftButtonUp"
                        MouseWheel="Viewport_MouseWheel">
                    <Canvas>
                        <StackPanel x:Name="PagesStrip" Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PagesTransform" />
                            </StackPanel.RenderTransform>

                            <pages:HomePage />      <!-- 0 -->
                            <pages:MusicPage />     <!-- 1 -->
                            <pages:FocusPage />     <!-- 2 -->
                            <pages:WeatherPage />   <!-- 3 -->
                            <pages:MailPage />      <!-- 4 -->
                            <pages:ClaudePage />    <!-- 5 -->
                            <pages:VsCodePage />    <!-- 6 -->
                            <pages:NotesPage />     <!-- 7 -->
                            <pages:TodoPage />      <!-- 8 -->
                            <pages:CalendarPage />  <!-- 9 -->
                        </StackPanel>
                    </Canvas>
                </Border>

                <!-- Bottom tab bar -->
                <StackPanel x:Name="Tabs" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,12">
                    <Border Style="{StaticResource TabItem}" Tag="0" MouseLeftButtonUp="Navigate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="{loc:T TabHome}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="1" MouseLeftButtonUp="Navigate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="{loc:T TabMusic}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="2" MouseLeftButtonUp="Navigate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE916;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="{loc:T TabFocus}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="3" MouseLeftButtonUp="Navigate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE706;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="{loc:T TabWeather}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="4" MouseLeftButtonUp="Navigate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE715;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="{loc:T TabMail}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="5" MouseLeftButtonUp="Navigate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE756;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="{loc:T TabClaude}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="6" MouseLeftButtonUp="Navigate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE943;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="{loc:T TabVsCode}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="7" MouseLeftButtonUp="Navigate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE70B;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="{loc:T TabNotes}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="8" MouseLeftButtonUp="Navigate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D5;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="{loc:T TabTodo}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TabItem}" Tag="9" MouseLeftButtonUp="Navigate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}" />
                            <TextBlock Text="{loc:T TabCalendar}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="0" Opacity="0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
